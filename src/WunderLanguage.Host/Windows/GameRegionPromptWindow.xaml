<Window x:Class="WunderLanguage.Host.Windows.GameRegionPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WunderLanguage" Height="260" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Set your game region" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SubtleTextBrush}"
                   Text="Next, drag a box around the area where gameplay appears on screen - that's where WunderLanguage will look for text to translate. If it struggles reading the full gameplay area, you can recalibrate to a smaller box (like just the dialogue textbox) anytime from Settings."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="14,8" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Continue" Padding="18,8" Background="{StaticResource AccentBrush}"
                    Foreground="White" Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Window>
