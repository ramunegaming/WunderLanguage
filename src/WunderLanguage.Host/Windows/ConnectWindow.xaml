<Window x:Class="WunderLanguage.Host.Windows.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WunderLanguage - Connect" Height="480" Width="420"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="WunderLanguage" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Select the window to capture:" FontSize="13"
                   Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,12"/>

        <ListBox x:Name="WindowList" Grid.Row="2" Background="{StaticResource PanelBrush}"
                 Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                 Margin="0,0,0,12"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RefreshButton" Content="Refresh" Padding="14,8" Margin="0,0,8,0" Click="RefreshButton_Click"/>
            <Button x:Name="SettingsButton" Content="Settings" Padding="14,8" Margin="0,0,8,0" Click="SettingsButton_Click"/>
            <Button x:Name="ConnectButton" Content="Connect" Padding="18,8"
                    Background="{StaticResource AccentBrush}" Foreground="White" Click="ConnectButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
