<Window x:Class="WunderLanguage.Host.Windows.SidePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        RenderOptions.EdgeMode="Aliased">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource PanelBrush}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Live Chat" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0"
                           Text="Chat opens up once multiplayer rooms are built - single-player testing for now."/>
            </StackPanel>
            <Border Grid.Row="1" Background="{StaticResource InnerPanelBrush}" CornerRadius="6" Padding="12" VerticalAlignment="Stretch">
                <ScrollViewer x:Name="HistoryScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Width" Value="8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Background="Transparent" Width="8">
                                            <Border CornerRadius="4" Background="White" Opacity="0.08" Margin="2,0,2,0"/>
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border CornerRadius="4" Background="#6E6E7E" Margin="2,0,2,0" MinHeight="30"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel x:Name="HistoryPanel">
                        <TextBlock x:Name="PlaceholderText" Text="Waiting for dialogue..." FontSize="14"
                                   FontStyle="Italic" Foreground="{StaticResource SubtleTextBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                       Margin="0,12,0,0" Text="Word breakdown and notes are coming in a later pass."/>
        </Grid>
    </Border>
</Window>