<Window x:Class="WunderLanguage.Host.Windows.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" AllowsTransparency="True" Background="#59000000"
        Cursor="Cross">
    <Grid>
        <Canvas x:Name="OverlayCanvas" Background="Transparent"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseMove="Canvas_MouseMove"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
            <Rectangle x:Name="SelectionRect" Stroke="#7C5CFC" StrokeThickness="2"
                       Fill="#337C5CFC" Visibility="Collapsed"/>
        </Canvas>

        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" IsHitTestVisible="False">
            <Border Background="#16161D" CornerRadius="8" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="Drag a box around the game screen" FontSize="16" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#9A9AA5"
                               HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="420" TextAlignment="Center"
                               Text="Include only the actual gameplay area - exclude the title bar, menus, and any window borders."/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="ConfirmPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,60" Visibility="Collapsed">
            <Button Content="Redo Selection" Padding="16,10" Margin="0,0,10,0" Click="Redo_Click"/>
            <Button Content="Confirm (Enter)" Padding="20,10" Background="#7C5CFC" Foreground="White" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
