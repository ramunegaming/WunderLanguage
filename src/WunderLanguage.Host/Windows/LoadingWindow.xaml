<Window x:Class="WunderLanguage.Host.Windows.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WunderLanguage" Height="160" Width="380"
        WindowStartupLocation="CenterScreen" Topmost="True"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="WunderLanguage" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock x:Name="StatusText" Text="Starting up..." FontSize="13"
                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
