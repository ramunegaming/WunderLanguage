<Application x:Class="WunderLanguage.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0F0F14"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#16161D"/>
        <SolidColorBrush x:Key="InnerPanelBrush" Color="#101016"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2A35"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFC"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8E8ED"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#9A9AA5"/>
    </Application.Resources>
</Application>
